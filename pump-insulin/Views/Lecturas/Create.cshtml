@model pumpinsulin.Models.Lectura

@{
    ViewData["Title"] = "Registrar Lectura Manual";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0">Añadir Lectura Individual</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-light border mb-4">
                    <small class="text-muted d-block">Dispositivo vinculado:</small>
                    <strong>@ViewBag.DispositivoInfo</strong>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="DispositivoId" />

                    <div class="mb-3">
                        <label asp-for="FechaHora" class="form-label fw-semibold">Fecha y Hora</label>
                        <input asp-for="FechaHora" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="FechaHora" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NivelGlucosaMgDl" class="form-label fw-semibold">Glucemia (mg/dL)</label>
                            <div class="input-group">
                                <input asp-for="NivelGlucosaMgDl" type="number" step="0.1" class="form-control form-control-lg" placeholder="Ej: 110" required />
                                <span class="input-group-text fw-bold">mg/dL</span>
                            </div>
                            <span asp-validation-for="NivelGlucosaMgDl" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="InsulinaSuministradaU" class="form-label fw-semibold">Insulina Suministrada (U)</label>
                            <div class="input-group">
                                <input asp-for="InsulinaSuministradaU" type="number" step="0.1" class="form-control form-control-lg" placeholder="Ej: 2.5" required />
                                <span class="input-group-text fw-bold">U</span>
                            </div>
                            <span asp-validation-for="InsulinaSuministradaU" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HidratosCarbonoG" class="form-label fw-semibold">Hidratos de Carbono (Opcional)</label>
                            <div class="input-group">
                                <input asp-for="HidratosCarbonoG" type="number" step="0.1" class="form-control" placeholder="Ej: 45" />
                                <span class="input-group-text">g</span>
                            </div>
                            <span asp-validation-for="HidratosCarbonoG" class="text-danger small"></span>
                            <div class="form-text">Gramos de HC consumidos.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="RatioInsulina" class="form-label fw-semibold">Ratio de Insulina (Opcional)</label>
                            <div class="input-group">
                                <input asp-for="RatioInsulina" type="number" step="0.01" class="form-control" placeholder="Ej: 1.2" />
                                <span class="input-group-text">U/ración</span>
                            </div>
                            <span asp-validation-for="RatioInsulina" class="text-danger small"></span>
                            <div class="form-text">Ratio aplicada para la comida.</div>
                        </div>
                    </div>

                    <div class="alert alert-secondary small mt-2">
                        💡 <strong>Alerta automática:</strong> el sistema marcará alerta si el valor es ≤ 65 (Hipoglucemia) o ≥ 200 (Hiperglucemia).
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success py-2 fw-semibold">Guardar Lectura</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}