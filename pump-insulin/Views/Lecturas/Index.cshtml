@model IEnumerable<pumpinsulin.Models.Lectura>

@{
    ViewData["Title"] = "Historial de Lecturas";
}

<!-- Avisos automáticos tras registrar una lectura (Normal / Hipoglucemia / Hiperglucemia) -->
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-@TempData["TipoAviso"] alert-dismissible fade show fw-semibold fs-5 text-center shadow-sm mb-4" role="alert">
        @TempData["Aviso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Registro de Lecturas</h2>
        <p class="text-muted small mb-0">Control glucémico, administración de insulina y eventos de alerta</p>
    </div>
    
    <div class="btn-toolbar gap-2" role="toolbar">
        <a asp-action="Grafico" class="btn btn-outline-info">
            📊 Ver Gráfico
        </a>
        
        @if (User.IsInRole("Paciente"))
        {
            <a asp-action="Create" class="btn btn-primary">
                + Nueva Lectura
            </a>
            <a asp-action="SubirArchivo" class="btn btn-success">
                📁 Importar CSV
            </a>
        }
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Glucosa</th>
                    <th>Insulina</th>
                    <th>Estado / Alerta</th>
                    <th>Dispositivo</th>
                    @if (User.IsInRole("Medico"))
                    {
                        <th>Paciente</th>
                    }
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="@(User.IsInRole("Medico") ? 7 : 6)" class="text-center py-4 text-muted">
                            No hay lecturas registradas todavía.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model) {
                        <tr>
                            <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <strong>@item.NivelGlucosaMgDl</strong> <span class="small text-muted">mg/dL</span>
                            </td>
                            <td>
                                @item.InsulinaSuministradaU <span class="small text-muted">U</span>
                            </td>
                            <td>
                                @switch (item.Alerta)
                                {
                                    case pumpinsulin.Models.EstadoAlerta.Normal:
                                        <span class="badge bg-success">Normal</span>
                                        break;
                                    case pumpinsulin.Models.EstadoAlerta.Hipoglucemia:
                                   
                                        <span class="badge bg-danger">@item.Alerta</span>
                                        break;
                                    case pumpinsulin.Models.EstadoAlerta.Hiperglucemia:
                                        <span class="badge bg-warning text-dark">Hiperglucemia</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@item.Alerta</span>
                                        break;
                                }
                            </td>
                            <td>
                                @(item.Dispositivo != null ? $"{item.Dispositivo.Modelo} ({item.Dispositivo.NumeroSerie})" : "N/D")
                            </td>
                            @if (User.IsInRole("Medico"))
                            {
                                <td>
                                    @(item.Dispositivo?.Paciente != null ? $"{item.Dispositivo.Paciente.Nombre} {item.Dispositivo.Paciente.Apellidos}" : "Sin paciente")
                                </td>
                            }
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>