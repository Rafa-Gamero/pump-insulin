@model IEnumerable<pumpinsulin.Models.Lectura>

@{
    ViewData["Title"] = "Lecturas de Glucosa e Insulina";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Registro de Lecturas</h2>
    <a asp-action="Create" class="btn btn-primary">Nueva Lectura</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Fecha y Hora</th>
            <th>Glucosa (mg/dL)</th>
            <th>Insulina (U)</th>
            <th>Estado / Alerta</th>
            <th>Dispositivo</th>
            <th>Paciente</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
            <td><strong>@item.NivelGlucosaMgDl</strong></td>
            <td>@item.InsulinaSuministradaU</td>
            <td>
                @switch (item.Alerta.ToString())
                {
                    case "Normal":
                        <span class="badge bg-success">Normal</span>
                        break;
                    case "Hipoglucemia":
                    case "HipoglucemiaLeve":
                    case "HipoglucemiaSevera":
                        <span class="badge bg-danger">@item.Alerta</span>
                        break;
                    case "Hiperglucemia":
                        <span class="badge bg-warning text-dark">Hiperglucemia</span>
                        break;
                    default:
                        <span class="badge bg-secondary">@item.Alerta</span>
                        break;
                }
            </td>
            <td>@(item.Dispositivo != null ? $"{item.Dispositivo.Modelo} ({item.Dispositivo.NumeroSerie})" : "N/D")</td>
            <td>@(item.Dispositivo?.Paciente != null ? $"{item.Dispositivo.Paciente.Nombre} {item.Dispositivo.Paciente.Apellidos}" : "Sin paciente")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>