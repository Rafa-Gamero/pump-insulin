@model pumpinsulin.Models.Paciente

@{
    ViewData["Title"] = "Eliminar Paciente";
}

<h2 class="text-danger">Eliminar Paciente</h2>
<h4>¿Estás seguro de que deseas eliminar a este paciente?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Apellidos</dt>
    <dd class="col-sm-9">@Model.Apellidos</dd>

    <dt class="col-sm-3">DNI</dt>
    <dd class="col-sm-9">@Model.Dni</dd>

    <dt class="col-sm-3">Médico</dt>
    <dd class="col-sm-9">
        @(Model.Medico != null ? $"{Model.Medico.Nombre} {Model.Medico.Apellidos}" : "Sin asignar")
    </dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>